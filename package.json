{
  "name": "geckou-monorepo",
  "private": true,
  "packageManager": "yarn@1.22.22",
  "workspaces": {
    "packages": [
      "apps/*",
      "packages/*"
    ],
    "nohoist": [
      "@geckou/mobile/**",
      "@geckou/mobile-*/**"
    ]
  },
  "scripts": {
    "setup": "bash scripts/setup.sh",
    "dev": "turbo dev",
    "dev:web": "rm -rf apps/web/.next && turbo dev --filter=@geckou/web...",
    "dev:mobile": "turbo dev --filter=@geckou/mobile...",
    "dev:functions": "turbo dev --filter=@geckou/functions...",
    "build": "turbo build",
    "build:functions": "turbo build --filter=@geckou/functions",
    "lint": "turbo lint",
    "lint:fix": "turbo lint:fix",
    "format": "bash scripts/format.sh",
    "format:check": "bash scripts/format.sh --check",
    "type-check": "turbo type-check",
    "test": "turbo test",
    "env:develop": "bash scripts/use-env.sh develop",
    "env:staging": "bash scripts/use-env.sh staging",
    "env:production": "bash scripts/use-env.sh production",
    "firebase:emulators": "firebase emulators:start",
    "firebase:deploy": "firebase deploy",
    "firebase:deploy:functions": "firebase deploy --only functions",
    "firebase:deploy:hosting": "firebase deploy --only hosting",
    "deploy:develop": "bash scripts/deploy.sh develop",
    "deploy:staging": "bash scripts/deploy.sh staging",
    "deploy:production": "bash scripts/deploy.sh production",
    "prepare": "husky",
    "test:rules": "bash scripts/test-rules.sh",
    "test:hooks": "bash scripts/test-hooks.sh",
    "test:api-diff": "bash scripts/test-api-diff.sh",
    "test:release-command": "bash scripts/test-release-command.sh",
    "check:docs": "bash scripts/check-docs.sh",
    "release": "bash scripts/release.sh"
  },
  "resolutions": {
    "tar": ">=7.5.11",
    "@xmldom/xmldom": ">=0.8.12",
    "@tootallnate/once": ">=3.0.1",
    "vite": "~7.3.2",
    "eslint-plugin-react-hooks": "^5"
  },
  "devDependencies": {
    "@commitlint/cli": "^21",
    "@firebase/rules-unit-testing": "^4.0.0",
    "@geckou/commitlint-config": "^0.1.0",
    "@geckou/prettier-config": "^0.1.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.2.5",
    "firebase": "^11.0.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "next": "^15.5.23",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.0.0",
    "turbo": "^2.10.11",
    "typescript": "^5.0.0",
    "vitest": "^4.1.11"
  }
}
