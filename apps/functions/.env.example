# Functions 固有の環境変数
# firebase emulators や deploy 時に使用される
# ローカル開発では apps/functions/.env にコピーして値を入力

# RevenueCat Webhook の Authorization ヘッダー値
# RevenueCat Dashboard > Integrations > Webhooks > Authorization header value
# に設定した値と同じものを入れる（例: Bearer xxxxx）
REVENUECAT_WEBHOOK_AUTH=

# CORS 許可オリジン（カンマ区切り。未設定なら全許可 = 開発用）
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# 外部 API キー（例）
# OPENAI_API_KEY=
# GOOGLE_SHEETS_ID=
