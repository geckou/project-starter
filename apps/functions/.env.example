# Functions 固有の環境変数
# firebase emulators や deploy 時に使用される
#
# apps/functions/.env は `yarn env:<環境名>` がルートの .env.<環境名> から
# 自動生成する。直接編集しても環境切り替えで上書きされるため、
# 値を変えるときはルートの .env.<環境名> を編集すること。
# 配布対象のキーは scripts/use-env.sh の FUNCTIONS_ENV_KEYS で管理する。
#
# このファイルは「Functions がどの環境変数を使うか」のリファレンスとして残す

# layer:billing:start
# === 課金: RevenueCat（Mobile のアプリ内課金 / IAP） ===
# RevenueCat Webhook の Authorization ヘッダー値
# RevenueCat Dashboard > Integrations > Webhooks > Authorization header value
# に設定した値と同じものを入れる（例: Bearer xxxxx）
# アプリ内課金を使わないプロダクトでは空でよい
REVENUECAT_WEBHOOK_AUTH=

# === 課金: Stripe（Web 決済） ===
# Stripe Dashboard > 開発者 > API キー のシークレットキー（sk_...）
STRIPE_SECRET_KEY=

# Stripe Dashboard > 開発者 > Webhook のエンドポイント署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=

# 購入を許可する price ID の許可リスト（カンマ区切り）
# 例: STRIPE_PRICE_IDS=price_xxx,price_yyy
STRIPE_PRICE_IDS=

# Checkout 完了・中断後のリダイレクト先。
# クライアントから受け取らずサーバー側で固定する（オープンリダイレクト防止）
STRIPE_SUCCESS_URL=https://example.com/billing?status=success
STRIPE_CANCEL_URL=https://example.com/billing?status=cancelled

# カスタマーポータルから戻ってくる先
STRIPE_PORTAL_RETURN_URL=https://example.com/billing

# === 課金: カスタムクレーム同期（任意） ===
# 権利状態を Firebase Auth のカスタムクレームにも書き込むか。'true' でのみ有効。
# セキュリティルールから request.auth.token.subscriptionActive を参照する場合に有効化する。
# 画面側の表示制御しかしないなら Firestore を読めば足りるので不要
# SYNC_SUBSCRIPTION_CLAIMS=true
# layer:billing:end

# CORS 許可オリジン（カンマ区切り。未設定なら全許可 = 開発用）
# ALLOWED_ORIGINS=https://example.com,https://app.example.com

# Sentry（Functions 用 DSN。未設定なら送信しない）
# SENTRY_DSN=

# 外部 API キー（例）
# OPENAI_API_KEY=
# GOOGLE_SHEETS_ID=
