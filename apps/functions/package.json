{
  "name": "@geckou/functions",
  "version": "0.1.0",
  "private": true,
  "main": "dist/index.js",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --platform=node --target=node22 --outfile=dist/index.js --external:firebase-admin --external:firebase-functions --external:express --external:cors --external:stripe",
    "dev": "yarn build && firebase emulators:start --only functions",
    "type-check": "tsc --noEmit && tsc -p tsconfig.test.json",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "serve": "yarn build && firebase emulators:start --only functions",
    "deploy": "firebase deploy --only functions",
    "lint:fix": "eslint . --fix"
  },
  "engines": {
    "node": "22"
  },
  "dependencies": {
    "@geckou/shared": "*",
    "cors": "^2.8.5",
    "express": "^4.22.2",
    "firebase-admin": "^13.10.0",
    "firebase-functions": "^6.0.0",
    "stripe": "^22.0.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^22.20.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "firebase-functions-test": "^3.5.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.10"
  }
}
