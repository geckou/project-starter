{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["ES2017"],
    "module": "commonjs",
    "moduleResolution": "node",
    "rootDir": "./src",
    "outDir": "./dist",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "declaration": true,
    "declarationMap": true,
    "composite": true,
    // dist の外（既定は packages/shared/tsconfig.tsbuildinfo）に置くと、
    // rm -rf dist しても tsc が「出力済み」と判断して CJS を出し直さない。
    // ESM 側は毎回出るので、dist が ESM だけの片肺になる
    "tsBuildInfoFile": "./dist/tsconfig.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules"]
}
