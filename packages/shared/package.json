{
  "name": "@geckou/shared",
  "version": "0.1.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./types": {
      "types": "./src/types/index.ts",
      "default": "./dist/types/index.js"
    },
    "./utils": {
      "types": "./src/utils/index.ts",
      "default": "./dist/utils/index.js"
    },
    "./firebase": {
      "types": "./src/firebase/index.ts",
      "default": "./dist/firebase/index.js"
    },
    "./firestore": {
      "types": "./src/firestore/index.ts",
      "default": "./dist/firestore/index.js"
    },
    "./theme": {
      "types": "./src/theme/index.ts",
      "default": "./dist/theme/index.js"
    },
    "./stores": {
      "types": "./src/stores/index.ts",
      "default": "./dist/stores/index.js"
    },
    "./storage": {
      "types": "./src/storage/index.ts",
      "default": "./dist/storage/index.js"
    },
    "./i18n": {
      "types": "./src/i18n/index.ts",
      "default": "./dist/i18n/index.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "type-check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "firebase": "^11.0.0",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "eslint": "^9.0.0",
    "typescript": "^5.0.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^3.0.0"
  }
}
