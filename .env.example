# =============================================================
# 環境変数テンプレート
#
# このファイルを各環境用にコピーして値を入力する:
#   cp .env.example .env.develop
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# 編集後、使う環境に切り替える:
#   yarn env:develop   # .env.develop → .env.local にコピー + firebase use develop
#   yarn env:staging
#   yarn env:production
#
# 環境ごとに変える主な値:
#   BASIC_AUTH_CREDENTIALS（production は未設定）
#   NEXT_PUBLIC_API_BASE_URL / EXPO_PUBLIC_API_BASE_URL
#   NEXT_PUBLIC_GTM_ID
#   NEXT_PUBLIC_SENTRY_DSN / SENTRY_DSN / EXPO_PUBLIC_SENTRY_DSN
#   Firebase 設定値（プロジェクトを分けている場合）
#
# CI 自動デプロイ（staging / production のみ。develop は手動デプロイ）では、
# これらのファイル全文を GitHub Secrets に登録する:
#   gh secret set ENV_FILE_STAGING < .env.staging
#   gh secret set ENV_FILE_PRODUCTION < .env.production
# 詳細は README「環境変数の設定」/ .claude/docs/git-workflow.md を参照。
# =============================================================

# === Basic 認証（dev/stg のみ） ===
# user:password 形式。設定すると全ページに Basic 認証がかかる
# production では設定しないこと
# BASIC_AUTH_CREDENTIALS=user:password

# === Analytics（任意: 不要なら空のままでOK） ===
NEXT_PUBLIC_GTM_ID=

# === Web (Next.js) ===
# Firebase Console > Project Settings > General > Web app から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Mobile (Expo) ===
# app.config.ts の extra で参照される環境変数
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# === Server-side (firebase-admin for Next.js SSR) ===
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ダウンロードした JSON を1行の文字列にして設定する:
#   macOS: cat service-account.json | jq -c . | pbcopy
#   そのまま貼り付け
# ローカルでは GOOGLE_APPLICATION_CREDENTIALS の方が簡単（下記参照）
FIREBASE_SERVICE_ACCOUNT_KEY=

# === 課金: RevenueCat（Mobile のアプリ内課金 / IAP） ===
# アプリ内で即購入させたいプロダクトのみ設定する。Web だけで売るなら空でよい
# RevenueCat Dashboard > Projects > API Keys から取得
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=

# === 課金: Stripe（Web 決済） ===
# Web で売らないプロダクトなら空でよい（未設定なら Web 決済のエンドポイントは 503 を返す）
# 購入させる price ID。Stripe Dashboard > 商品 から取得
# NEXT_PUBLIC_ はブラウザに露出するが、price ID は公開されても問題ない値
NEXT_PUBLIC_STRIPE_PRICE_ID=

# === Firebase Emulator (ローカル開発用) ===
# true にすると Web がローカルの Firebase エミュレーターに接続する
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# 本番では不要（ADC を使用）
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# === Cloud Functions 専用 ===
# CORS で許可するオリジン（カンマ区切り）
ALLOWED_ORIGINS=
# RevenueCat Webhook の Authorization ヘッダー検証値
REVENUECAT_WEBHOOK_AUTH=
# Stripe のシークレットキー（sk_...）。絶対に NEXT_PUBLIC_ を付けないこと
STRIPE_SECRET_KEY=
# Stripe Webhook の署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 購入を許可する price ID の許可リスト（カンマ区切り）。
# クライアントから任意の price を渡されないようサーバー側で検証する
STRIPE_PRICE_IDS=
# Checkout 完了 / 中断後の戻り先とカスタマーポータルの戻り先
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
# 権利状態を Firebase Auth のカスタムクレームに同期するか（'true' で有効）。
# セキュリティルールから request.auth.token.subscriptionActive を使う場合のみ有効にする
SYNC_SUBSCRIPTION_CLAIMS=

# --- API ---
NEXT_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
