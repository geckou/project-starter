# =============================================================
# 環境変数テンプレート
#
# このファイルを各環境用にコピーして値を入力する:
#   cp .env.example .env.develop
#   cp .env.example .env.staging
#   cp .env.example .env.production
#
# 編集後、使う環境に切り替える:
#   yarn env:develop   # .env.develop → .env.local にコピー + firebase use develop
#   yarn env:staging
#   yarn env:production
#
# yarn env:<環境名> は以下を配布する:
#   .env.local / apps/web/.env.local … 全文をコピー
# layer:mobile:start
#   apps/mobile/.env.local … 全文をコピー
# layer:mobile:end
# layer:functions:start
#   apps/functions/.env … Functions が使うキーだけを抽出して生成
#     （デプロイ時に関数の環境変数として取り込まれるため、
#       FIREBASE_SERVICE_ACCOUNT_KEY 等の不要な値は載せない）
#     配布対象のキーは scripts/use-env.sh の FUNCTIONS_ENV_KEYS で管理する
# layer:functions:end
#
# layer:billing:start
# production 以外に Stripe の本番キー（sk_live_ / rk_live_）が入っていると
# yarn env:<環境名> はエラーで停止する（開発中の実課金を防ぐため）
# layer:billing:end
#
# 環境ごとに変える主な値:
#   BASIC_AUTH_CREDENTIALS（production は未設定）
# layer:functions:start
#   NEXT_PUBLIC_API_BASE_URL / EXPO_PUBLIC_API_BASE_URL
# layer:functions:end
#   NEXT_PUBLIC_GTM_ID
#   NEXT_PUBLIC_SENTRY_DSN / SENTRY_DSN / EXPO_PUBLIC_SENTRY_DSN
# layer:firebase:start
#   Firebase 設定値（プロジェクトを分けている場合）
# layer:firebase:end
#
# CI 自動デプロイ（staging / production のみ。develop は手動デプロイ）では、
# これらのファイル全文を GitHub Secrets に登録する:
#   gh secret set ENV_FILE_STAGING < .env.staging
#   gh secret set ENV_FILE_PRODUCTION < .env.production
# 詳細は README「環境変数の設定」/ .claude/docs/git-workflow.md を参照。
# =============================================================

# === Basic 認証（dev/stg のみ） ===
# user:password 形式。設定すると全ページに Basic 認証がかかる
# production では設定しないこと
# BASIC_AUTH_CREDENTIALS=user:password

# === Analytics（任意: 不要なら空のままでOK） ===
NEXT_PUBLIC_GTM_ID=

# layer:firebase:start
# === Web (Next.js) ===
# Firebase Console > Project Settings > General > Web app から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# layer:firebase:end

# layer:mobile:start
# === Mobile (Expo) ===
# app.config.ts の extra で参照される環境変数
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
# layer:mobile:end

# layer:firebase:start
# === Server-side (firebase-admin for Next.js SSR) ===
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ダウンロードした JSON を1行の文字列にして設定する:
#   macOS: cat service-account.json | jq -c . | pbcopy
#   そのまま貼り付け
# ローカルでは GOOGLE_APPLICATION_CREDENTIALS の方が簡単（下記参照）
FIREBASE_SERVICE_ACCOUNT_KEY=
# layer:firebase:end

# layer:billing,mobile:start
# === 課金: RevenueCat（Mobile のアプリ内課金 / IAP） ===
# アプリ内で即購入させたいプロダクトのみ設定する。Web だけで売るなら空でよい
# RevenueCat Dashboard > Projects > API Keys から取得
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=
# layer:billing,mobile:end

# layer:billing:start
# === 課金: Stripe（Web 決済） ===
# Web で売らないプロダクトなら空でよい（未設定なら Web 決済のエンドポイントは 503 を返す）
# 購入させる price ID。Stripe Dashboard > 商品 から取得
# NEXT_PUBLIC_ はブラウザに露出するが、price ID は公開されても問題ない値
NEXT_PUBLIC_STRIPE_PRICE_ID=
# layer:billing:end

# layer:firebase:start
# === Firebase Emulator (ローカル開発用) ===
# true にすると Web がローカルの Firebase エミュレーターに接続する
# NEXT_PUBLIC_USE_FIREBASE_EMULATOR=true
# Cloud Run / Cloud Functions では不要（ADC が自動で使われる。環境変数は付かない）。
# ローカルで Admin SDK を使うときは gcloud auth application-default login か、
# サービスアカウントの鍵のパスを設定する
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json
# layer:firebase:end

# layer:functions:start
# === Cloud Functions 専用 ===
# CORS で許可するオリジン（カンマ区切り）。
# エミュレーターの外では必須（未設定だと /api が 500 を返す）。
# 空のまま本番へ出すと全オリジンからの API 利用を許すため、フォールバックしない
ALLOWED_ORIGINS=
# layer:functions:end
# layer:billing:start
# RevenueCat Webhook の Authorization ヘッダー検証値
REVENUECAT_WEBHOOK_AUTH=
# Sandbox（TestFlight / 内部テストトラック）の購入イベントを適用するか。
# 既定（空 / false）では無視して 200 を返す（本番の Webhook URL を開発ビルドが
# 叩いたときに、サンドボックス購入で本番の権利が付くのを防ぐため）。
# develop 環境でのみ true にする
REVENUECAT_ALLOW_SANDBOX=
# Stripe のシークレットキー（sk_...）。絶対に NEXT_PUBLIC_ を付けないこと
STRIPE_SECRET_KEY=
# Stripe Webhook の署名シークレット（whsec_...）
STRIPE_WEBHOOK_SECRET=
# 購入を許可する price ID の許可リスト（カンマ区切り）。
# クライアントから任意の price を渡されないようサーバー側で検証する
STRIPE_PRICE_IDS=
# Checkout 完了 / 中断後の戻り先とカスタマーポータルの戻り先
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
STRIPE_PORTAL_RETURN_URL=
# 権利状態を Firebase Auth のカスタムクレームに同期するか（'true' で有効）。
# セキュリティルールから request.auth.token.subscriptionActive を使う場合のみ有効にする
SYNC_SUBSCRIPTION_CLAIMS=
# layer:billing:end

# layer:functions:start
# --- API ---
NEXT_PUBLIC_API_BASE_URL=
# layer:functions:end
# layer:mobile:start
EXPO_PUBLIC_API_BASE_URL=
# layer:mobile:end

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
# layer:functions:start
SENTRY_DSN=
# layer:functions:end
# layer:mobile:start
EXPO_PUBLIC_SENTRY_DSN=
# layer:mobile:end
