# === Analytics（任意: 不要なら空のままでOK） ===
NEXT_PUBLIC_GTM_ID=

# === Web (Next.js) ===
# Firebase Console > Project Settings > General > Web app から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# === Mobile (Expo) ===
# app.json の extra で参照される環境変数
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=

# === Server-side (firebase-admin for Next.js SSR) ===
# Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# ダウンロードした JSON を1行の文字列にして設定する:
#   macOS: cat service-account.json | jq -c . | pbcopy
#   そのまま貼り付け
# ローカルでは GOOGLE_APPLICATION_CREDENTIALS の方が簡単（下記参照）
FIREBASE_SERVICE_ACCOUNT_KEY=

# === RevenueCat ===
# RevenueCat Dashboard > Projects > API Keys から取得
# Web（NEXT_PUBLIC_ はブラウザに露出する）
NEXT_PUBLIC_REVENUECAT_API_KEY=
# Mobile（iOS / Android それぞれ）
REVENUECAT_API_KEY_APPLE=
REVENUECAT_API_KEY_GOOGLE=

# === Firebase Emulator (ローカル開発用) ===
# 本番では不要（ADC を使用）
# GOOGLE_APPLICATION_CREDENTIALS=path/to/service-account.json

# --- API ---
NEXT_PUBLIC_API_BASE_URL=
EXPO_PUBLIC_API_BASE_URL=

# --- Sentry ---
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_DSN=
EXPO_PUBLIC_SENTRY_DSN=
