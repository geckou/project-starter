{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/session-start-git-context.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/session-start-questions.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/pre-git-guard.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/post-edit-reminder.sh"
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/post-git-branch-reminder.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh .claude/hooks/stop-dod-check.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/stop-roadmap-reminder.sh"
          },
          {
            "type": "command",
            "command": "sh .claude/hooks/stop-questions-reminder.sh"
          }
        ]
      }
    ]
  }
}
