rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // デフォルト: 全アクセス拒否
    match /{document=**} {
      allow read, write: if false;
    }

    // ユーザー: 本人のみ読み書き可
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId;
      allow update: if request.auth != null && request.auth.uid == userId;
      allow delete: if false;
    }

    // 1プロジェクト相乗り時は環境ごとに明示的に match を書く
    // ワイルドカード /{prefix}users はセグメント内マッチ不可
    // match /stg_users/{userId} { ... }
    // match /dev_users/{userId} { ... }

    // 例: 公開コレクション（認証済みユーザーのみ読み取り可）
    // match /posts/{postId} {
    //   allow read: if request.auth != null;
    //   allow create: if request.auth != null;
    //   allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
    //   allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    // }
  }
}
