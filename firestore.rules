rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // デフォルト: 全アクセス拒否
    match /{document=**} {
      allow read, write: if false;
    }

    // サーバー（Cloud Functions / Admin SDK）だけが書き込めるフィールド。
    // 課金の権利状態をクライアントから自己申告で書き換えられないようにする
    function serverOnlyFields() {
      return ['subscription', 'stripeCustomerId'];
    }

    // ユーザー: 本人のみ読み書き可。ただし課金関連フィールドは書き換え不可
    match /users/{userId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.keys().hasAny(serverOnlyFields());
      allow update: if request.auth != null && request.auth.uid == userId
                    && !request.resource.data.diff(resource.data)
                         .affectedKeys().hasAny(serverOnlyFields());
      allow delete: if false;
    }

    // 課金 Webhook の処理済みイベント（冪等性のため Functions が書く）。
    // クライアントからは読み書きさせないので、上の default deny に任せる
    // match /billing_events/{eventId} — 明示的な許可なし

    // 1プロジェクト相乗り時は環境ごとに明示的に match を書く
    // ワイルドカード /{prefix}users はセグメント内マッチ不可
    // match /stg_users/{userId} { ... }
    // match /dev_users/{userId} { ... }

    // 例: 有料プラン限定のコレクション。
    // apps/functions/.env で SYNC_SUBSCRIPTION_CLAIMS=true にすると Webhook が
    // カスタムクレームへ同期するので、Firestore の get() なしで判定できる
    // （未設定だとクレームが存在せず全員拒否になる。
    //   またクレームは ID トークン更新まで最大1時間古い点にも注意）
    // match /premium_items/{itemId} {
    //   allow read: if request.auth != null;
    //   allow write: if request.auth != null
    //                && request.auth.token.subscriptionActive == true;
    // }

    // 例: 公開コレクション（認証済みユーザーのみ読み取り可）
    // match /posts/{postId} {
    //   allow read: if request.auth != null;
    //   allow create: if request.auth != null;
    //   allow update: if request.auth != null && resource.data.authorId == request.auth.uid;
    //   allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    // }
  }
}
